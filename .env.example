# Leave FALKORDB_PASSWORD empty for no auth (local dev: the browser login
# then needs only redis://falkordb-server). Set it to enable auth; scripts
# read the same value.
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
FALKORDB_PASSWORD=
FALKORDB_THREADS=4
# NCBI E-utilities key for bpgraph-pubmed: ten requests a second instead of
# three. From your NCBI account settings, under API Key Management.
# NCBI_API_KEY=
