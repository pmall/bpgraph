# Leave FALKORDB_PASSWORD empty for no auth (local dev: the browser login
# then needs only redis://falkordb-server). Set it to enable auth; scripts
# read the same value.
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
FALKORDB_PASSWORD=
FALKORDB_THREADS=4
# Where a build publishes the live graph's vaults, and the API reads them
# outside Docker. Docker Compose mounts data/vault itself.
# BPGRAPH_VAULT=data/vault
